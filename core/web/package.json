{
	"name": "frontend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"shadup": "shadcn-svelte update --all",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint && eslint src && pnpm lint:tw",
		"lint:fix": "oxlint --fix && pnpm lint:tw --fix",
		"lint:tw": "tailwint --ignore \"src/lib/components/ui/**\" --ignore \"src/lib/gen/**\" \"src/**/*.svelte\" \"src/**/*.ts\" \"src/**/*.css\""
	},
	"dependencies": {
		"@fontsource-variable/manrope": "^5.3.0",
		"@fontsource-variable/victor-mono": "^5.3.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"asciinema-player": "^3.18.0"
	},
	"devDependencies": {
		"@bufbuild/protobuf": "^2.17.0",
		"@connectrpc/connect": "^2.3.0",
		"@connectrpc/connect-query-core": "^2.3.1",
		"@connectrpc/connect-web": "^2.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.72.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/svelte-query": "^6.4.1",
		"@tanstack/svelte-table": "9.3.1",
		"@types/node": "^26.6.6",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@xyflow/svelte": "^1.7.1",
		"bits-ui": "^2.21.0",
		"cn": "^0.5.2",
		"eslint": "^10.14.0",
		"eslint-plugin-svelte": "^3.24.1",
		"mode-watcher": "^1.1.0",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"oxlint-tsgolint": "^7.0.2007",
		"runed": "^0.38.0",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"svelte-toolbelt": "^0.13.0",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"tailwint": "^1.1.16",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8"
	}
}
