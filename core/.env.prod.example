# Copy to .env and fill in your values, then run:
#   docker compose -f compose.prod.yml up -d
# (The .env file is gitignored, never commit real secrets.)

# --- Image ---------------------------------------------------------------
# Override with your own build when ready.
NOKKU_IMAGE=ghcr.io/nokku-sh/nokku:latest

# Public host name, without a scheme or a path. Used for links, cookies and
# passkeys, and as the Caddy site address. compose.prod.yml gets its
# certificate from Let's Encrypt, compose.min.yml from a CA of Caddy's own.
# It has to be a name, an IP address takes no passkey.
NOKKU_BASE_URL=nokku.example.com

# --- Encryption & sessions ----------------------------------------------
# Master secret, at least 32 characters. It wraps the keyset that encrypts CA
# keys, recordings and SSO client secrets. With a KMS, set KMS_URI and leave
# this out. The server refuses to start with this placeholder.
# Change it later with `nokku rotate-secrets`. Generate with:
#   openssl rand -hex 32
NOKKU_SECRET=CHANGE_ME_generate_with_openssl_rand

# --- Database -------------------------------------------------------------
# Admin/superuser credentials: used to create the Postgres database and by
# nokku for schema migrations and maintenance. Requests are never served
# through this connection.
POSTGRES_USER=nokku
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=nokku

# --- First start: the owner account -----------------------------------------
# Creates the owner of the workspace, ignored once there is one. Without it
# nobody can sign in to a fresh install. There is no password, run
# `nokku admin-link` for a sign-in link. The log reminds you until the owner
# has a passkey, but never shows the link itself.
# NOKKU_ADMIN_EMAIL=admin@example.com
# NOKKU_ADMIN_NAME=Admin

# --- Optional: email delivery ------------------------------------------------
# Mail is off until NOKKU_SMTP_HOST is set. Any SMTP relay works,
# e.g. Scaleway TEM at smtp.tem.scw.cloud.
# NOKKU_SMTP_HOST=smtp.example.com
# NOKKU_SMTP_PORT=587
# NOKKU_SMTP_USERNAME=
# NOKKU_SMTP_PASSWORD=
# NOKKU_SMTP_FROM=noreply@nokku.example.com

# --- Optional: OAuth login providers ------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=

# --- Optional: S3-compatible storage (instead of the local volume) ------------
# NOKKU_STORAGE_URL=s3://nokku?region=auto&endpoint=https%3A%2F%2Fs3.example.com&use_path_style=true
# On Scaleway:
# NOKKU_STORAGE_URL=s3://nokku?region=fr-par&endpoint=https%3A%2F%2Fs3.fr-par.scw.cloud&request_checksum_calculation=when_required
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Optional: license key ----------------------------------------------------
# NOKKU_LICENSE_KEY=
# A core with a key asks license.nokku.sh once a day for the renewed one. Turn it off for air-gapped installs.
# NOKKU_LICENSE_OFFLINE=true
