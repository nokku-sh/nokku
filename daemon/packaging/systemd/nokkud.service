[Unit]
Description=Nokku Daemon
Documentation=https://github.com/nokku-sh/nokku/tree/main/daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/nokkud
# A reload says a new binary is in place. nokkud exits 75 once its sessions end.
ExecReload=/bin/kill -USR1 $MAINPID
Restart=on-failure
SuccessExitStatus=75
RestartForceExitStatus=75
# 78 means not enrolled, restarting cannot fix that.
RestartPreventExitStatus=78
RestartSec=5s
# A restart only signals the daemon. Live connections still end with it.
KillMode=process
# Sessions share this cgroup. One OOM kill in a session must not stop the unit.
OOMPolicy=continue
LimitNOFILE=65536

# No sandboxing. Sessions are children of the daemon and would inherit every restriction, even a root shell.

[Install]
WantedBy=multi-user.target
