#!/sbin/openrc-run

name="nokkud"
description="Nokku Daemon"
command="/usr/bin/nokkud"
pidfile="/run/${RC_SVCNAME}.pid"
command_background=true
# The output carries the audit events. syslog rotates it.
output_logger="logger -t nokkud"
error_logger="logger -t nokkud"

depend() {
    need net
    after firewall
}
