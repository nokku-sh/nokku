# Copy to .env and fill in your values, then run:
#   docker compose -f compose.prod.yml up -d
# (The .env file is gitignored; never commit real secrets.)

# --- Image ---------------------------------------------------------------
# Override with your own build when ready.
NOKKU_IMAGE=ghcr.io/nokku-sh/nokku:latest

# Public base URL, without a path. Used for links and redirects, and as the
# Caddy site address. A real domain enables automatic HTTPS (Let's Encrypt).
NOKKU_BASE_URL=https://nokku.example.com

# --- Encryption & sessions ----------------------------------------------
# Master secret, at least 32 characters. It wraps the keyset that encrypts CA
# keys, recordings and SSO client secrets, and it
# keys the DPoP nonce. The server refuses to start with this placeholder.
# Change it later with `nokku rotate-secrets`. Generate with:
#   openssl rand -hex 32
NOKKU_SECRET=CHANGE_ME_generate_with_openssl_rand

# --- Database -------------------------------------------------------------
# Admin/superuser credentials: used to create the Postgres database and by
# nokku for schema migrations and maintenance. Requests are never served
# through this connection.
POSTGRES_USER=nokku
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=nokku

# Optional: runtime role password. The app serves requests as a dedicated
# non-owner role (nokku_app) so row-level security always applies. Its
# password defaults to POSTGRES_PASSWORD. Set a separate one to fully detach
# the runtime role from the admin one, nokku applies it on boot.
# NOKKU_DB_APP_PASSWORD=CHANGE_ME

# --- First start: the owner account -----------------------------------------
# Creates the owner of the workspace, ignored once there is one. Without it
# nobody can sign in to a fresh install. There is no password. The server log
# shows a sign-in link, valid for 24 hours, at every start until the owner
# has a passkey. `nokku admin-link` prints a fresh one.
# NOKKU_ADMIN_EMAIL=admin@example.com
# NOKKU_ADMIN_NAME=Admin

# --- Optional: SSO egress ----------------------------------------------------
# The server fetches IdP URLs that workspace admins configure, so by default it
# only connects to public addresses. Set to true on a self-hosted install whose
# IdP lives on a private network. Keep it off on a multi-tenant deployment.
# NOKKU_ALLOW_PRIVATE_NETWORKS=false

# --- Optional: email delivery ------------------------------------------------
# Mail is off until NOKKU_SMTP_HOST is set. Any SMTP relay works,
# e.g. Scaleway TEM at smtp.tem.scw.cloud.
# NOKKU_SMTP_HOST=smtp.example.com
# NOKKU_SMTP_PORT=587
# NOKKU_SMTP_USERNAME=
# NOKKU_SMTP_PASSWORD=
# NOKKU_EMAIL_SENDER=noreply@nokku.example.com

# --- Optional: OAuth login providers ------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Optional: S3-compatible storage (instead of the local volume) ------------
# NOKKU_STORAGE=s3
# NOKKU_S3_ENDPOINT=https://s3.example.com
# NOKKU_S3_ACCESS_KEY_ID=
# NOKKU_S3_SECRET_ACCESS_KEY=
# NOKKU_S3_BUCKET=nokku-assets
# NOKKU_S3_REGION=auto
# NOKKU_S3_USE_PATH_STYLE=true

# --- Optional: Enterprise license key -----------------------------------------
# NOKKU_LICENSE_KEY=
